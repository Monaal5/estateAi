# AI Engine API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Priority list of models to use
GEMINI_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite

# PostgreSQL Database Connection String
# Local Postgres example: postgresql+psycopg://postgres:postgres@localhost:5432/estate_ai
# Render Cloud Postgres example: postgresql://username:password@hostname/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/estate_ai
