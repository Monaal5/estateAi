  "type": "module",
  "scripts": {
    "dev": "concurrently -n db,api,web -c yellow,cyan,magenta \"npm:db\" \"npm:server\" \"npm:client\"",
    "db": "D:\\pgsql\\bin\\postgres.exe -D D:\\pgsql\\data -p 5432",
    "client": "vite",
    "server": "backend\\.venv\\Scripts\\python -m uvicorn app.main:app --app-dir backend --port 5000 --reload --reload-dir backend/app",
    "db:start": "D:\\pgsql\\bin\\pg_ctl.exe -D D:\\pgsql\\data -l D:\\pgsql\\server.log -o \"-p 5432\" start",
    "db:stop": "D:\\pgsql\\bin\\pg_ctl.exe -D D:\\pgsql\\data stop",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
